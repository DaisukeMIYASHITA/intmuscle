NEXT_PUBLIC_WORLD_COIN_CLIENT_ID="your client id"
NEXT_PUBLIC_ORIGIN_PATH="ex. http://localhost:3000"
NEXT_PUBLIC_HUDDLE_KEY="your huddle key"

# Dedicated GA4 web stream for this app. Blank values disable all tag loading.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Exact verified production origin (https, no path/query/hash).
NEXT_PUBLIC_GA_SITE_URL=https://intmuscle-rho.vercel.app
# Set false to disable analytics even with a valid ID.
NEXT_PUBLIC_GA_ENABLED=true
